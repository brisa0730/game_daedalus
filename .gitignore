/Tools/fixtures/*/Library/
/Tools/fixtures/*/Temp/
/Tools/fixtures/*/Logs/
/Tools/fixtures/*/UserSettings/
/Tools/fixtures/*/Packages/packages-lock.json

# Environment
.env
